ARG BUILDPLATFORM
ARG TARGETPLATFORM

# UBI 10 — RHEL 10 has PQC crypto by default (no ubi-minimal-pqc / crypto-policies step).
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi10/go-toolset@sha256:e94c38ff4a099b755af60c73ac87198c613f369eb7f818d45c96fbc3f21047de AS builder
ARG CGO_ENABLED=1
ARG GOEXPERIMENT=strictfipsruntime
ARG TARGETOS
ARG TARGETARCH

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

USER root
RUN CGO_ENABLED=${CGO_ENABLED} GOEXPERIMENT=${GOEXPERIMENT} GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -a -trimpath -ldflags="-s -w" -o discovery ./cmd/discovery

FROM --platform=$TARGETPLATFORM registry.access.redhat.com/ubi10/ubi-minimal@sha256:f0c7b9ae9914fcf183e7c36fc46864903c2d2caf3af327421913ae54b3d29e94

WORKDIR /app

COPY --from=builder /app/discovery .

RUN chmod +x discovery && \
    chgrp -R 0 /app && \
    chmod -R g=u /app

USER 1001

EXPOSE 8443

ENTRYPOINT ["./discovery"]

LABEL com.redhat.component="odh-maas-discovery-rhel10" \
      name="rhoai/odh-maas-discovery-rhel10" \
      description="odh-maas-discovery" \
      summary="odh-maas-discovery" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-maas-discovery" \
      io.k8s.description="odh-maas-discovery-rhel10" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
